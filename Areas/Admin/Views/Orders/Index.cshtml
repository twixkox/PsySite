@model List<Order>
@{
    ViewData["Title"] = "Заказы";
    var current = ViewData["Status"] as OrderStatus?;
}
<div class="page-top">
    <h1>Заказы и оплаты</h1>
</div>

<div class="tabs">
    <a href="/admin/orders" class="@(current is null ? "active" : "")">Все</a>
    @foreach (OrderStatus s in Enum.GetValues<OrderStatus>())
    {
        <a href="/admin/orders?status=@s" class="@(current == s ? "active" : "")">@Fmt.Name(s)</a>
    }
</div>

@if (Model.Count == 0)
{
    <p class="empty">Заказов нет.</p>
}
else
{
    <table class="table panel">
        <thead>
            <tr><th>№</th><th>Что</th><th>Покупатель</th><th>Сумма</th><th>Статус</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var o in Model)
            {
                <tr>
                    <td>@o.Id<br /><span class="muted small nowrap">@Fmt.DateTime(o.CreatedAt)</span></td>
                    <td>
                        @if (o.Kind == OrderKind.Booking)
                        {
                            <a href="/admin/bookings/details/@o.ItemId">@o.Description</a>
                        }
                        else
                        {
                            <a href="/admin/articles/edit/@o.ItemId">@o.Description</a>
                        }
                        <br /><span class="muted small">@Fmt.Name(o.Kind)@(o.Provider is null ? "" : " · " + o.Provider)</span>
                    </td>
                    <td>@o.CustomerName<br /><span class="muted small">@o.CustomerEmail</span></td>
                    <td class="nowrap">@Fmt.Price(o.Amount)</td>
                    <td>
                        <span class="badge o-@o.Status">@Fmt.Name(o.Status)</span>
                        @if (o.PaidAt is DateTime paid) { <br /><span class="muted small nowrap">@Fmt.DateTime(paid)</span> }
                    </td>
                    <td class="right">
                        @if (o.Status == OrderStatus.Pending)
                        {
                            <form method="post" asp-antiforgery="true" action="/admin/orders/markpaid/@o.Id">
                                <button type="submit" class="link-btn" data-confirm="Отметить заказ №@o.Id оплаченным? Клиенту уйдёт письмо.">оплачен вручную</button>
                            </form>
                        }
                        else if (o.Status == OrderStatus.Paid)
                        {
                            <form method="post" asp-antiforgery="true" action="/admin/orders/markrefunded/@o.Id">
                                <button type="submit" class="link-btn danger" data-confirm="Отметить возврат по заказу №@o.Id? Сами деньги возвращаются в кабинете платёжной системы.">возврат</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
