<?xml version="1.0" encoding="utf-8"?>
<!--
  Профиль публикации для IIS.
  Visual Studio: правой кнопкой по проекту → «Опубликовать» → профиль IIS → «Опубликовать».
  Командная строка:  dotnet publish -c Release -p:PublishProfile=IIS
  Результат — папка bin\Release\publish-iis: её целиком копируют на сервер (см. deploy\update-site.ps1).
-->
<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <Configuration>Release</Configuration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <PublishUrl>bin\Release\publish-iis\</PublishUrl>
    <PublishDir>bin\Release\publish-iis\</PublishDir>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <ExcludeApp_Data>true</ExcludeApp_Data>

    <TargetFramework>net10.0</TargetFramework>
    <!-- Сборка под 64-битный Windows. Сам .NET на сервер ставится отдельно (Hosting Bundle). -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
</Project>
