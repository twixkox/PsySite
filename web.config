<?xml version="1.0" encoding="utf-8"?>
<!--
  Настройки IIS для сайта. При публикации (dotnet publish / Visual Studio) файл копируется в папку сайта,
  а строки processPath / arguments дописываются автоматически.

  Если сайт не запускается и показывает ошибку 500.30, временно поставьте stdoutLogEnabled="true":
  причина появится в папке App_Data\logs\stdout. После разбора верните "false".

  Ошибка 500.19 сразу после установки на Windows Server 2016 (IIS 10.0 до версии 1709): старый IIS не знает
  атрибут removeServerHeader — удалите его из строки <requestFiltering ...> ниже.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="%LAUNCHER_PATH%"
                  arguments="%LAUNCHER_ARGS%"
                  hostingModel="inprocess"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\App_Data\logs\stdout">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>

      <security>
        <!-- Не сообщать в ответах версию IIS (заголовок Server). -->
        <requestFiltering removeServerHeader="true">
          <!-- Картинки в админке — до 10 МБ; с запасом на саму форму. -->
          <requestLimits maxAllowedContentLength="15728640" />
        </requestFiltering>
      </security>

      <httpProtocol>
        <customHeaders>
          <!-- IIS по умолчанию добавляет X-Powered-By: ASP.NET — лишняя подсказка для взломщика. -->
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
