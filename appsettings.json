    "TimeZone": "Europe/Moscow",
    "BookingMinHoursAhead": 12,
    "UnpaidBookingHoldMinutes": 30
  },
  "Admin": {
    "Login": "admin",
    "Password": ""
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "UseSsl": true,
    "User": "",
    "Password": "",
    "From": "",
    "FromName": ""
  },
  "Payments": {
    "Provider": "Fake",
    "YooKassa": {
      "ShopId": "",
      "SecretKey": ""
    }
  },
  "Logs": {
    "RetainedDays": 30,
    "ErrorRetainedDays": 90,
    "FileSizeLimitMb": 50
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Fatal",
        "Microsoft.EntityFrameworkCore.Query": "Fatal",
        "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Fatal",
        "System.Net.Http.HttpClient": "Warning",
        "Microsoft.AspNetCore.DataProtection": "Error"
      }
    }
  },
  "AllowedHosts": "*"
}
