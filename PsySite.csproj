<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PsySite</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Настройки разработки (пароль admin123) на сервер не попадают. -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
    <!-- Настройки боевого сайта живут только на сервере: не публикуются и не перезаписываются. -->
    <Content Update="appsettings.Production.json" CopyToPublishDirectory="Never" />
    <!-- Папка deploy — скрипты для администратора, на сайт не публикуются. -->
    <Content Remove="deploy\**" />
    <None Include="deploy\**" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.*" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.*" />
  </ItemGroup>

</Project>
