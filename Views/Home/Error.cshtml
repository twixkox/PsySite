@{
    var code = (int)(ViewData["Code"] ?? 500);
    ViewData["Title"] = code == 404 ? "Страница не найдена" : "Ошибка";
}
<section class="page-head">
    <div class="container narrow">
        <p class="eyebrow">Ошибка @code</p>
        @if (code == 404)
        {
            <h1>Такой страницы нет</h1>
            <p class="lead">Возможно, она переехала или в адресе опечатка.</p>
        }
        else if (code == 429)
        {
            <h1>Слишком много запросов</h1>
            <p class="lead">Подождите несколько минут и попробуйте снова.</p>
        }
        else
        {
            <h1>Что-то пошло не так</h1>
            <p class="lead">Мы уже знаем о проблеме. Попробуйте обновить страницу чуть позже.</p>
        }
        <p><a href="/" class="btn">На главную</a></p>
    </div>
</section>
