@{
    var site = SiteOptions.Value;
    var title = ViewData["Title"] as string;
    var pageTitle = string.IsNullOrEmpty(title) ? $"{site.Name}. {site.Tagline}" : $"{title} — {site.Name}";
    var description = ViewData["Description"] as string ?? site.Tagline;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@pageTitle</title>
    <meta name="description" content="@description" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@description" />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="container header-inner">
            <a href="/" class="logo">
                <span class="logo-mark" aria-hidden="true">@site.Name.Substring(0, 1)</span>
                <span class="logo-text">@site.Name</span>
            </a>
            <button class="nav-toggle" type="button" aria-label="Меню" aria-expanded="false" aria-controls="main-nav">
                <span></span><span></span><span></span>
            </button>
            <nav id="main-nav" class="main-nav">
                @await Component.InvokeAsync("MainMenu")
                <a href="/consultations" class="btn btn-small nav-cta">Записаться</a>
            </nav>
        </div>
    </header>

    @if (TempData["Message"] is string msg)
    {
        <div class="container"><div class="flash flash-ok">@msg</div></div>
    }
    @if (TempData["Error"] is string err)
    {
        <div class="container"><div class="flash flash-error">@err</div></div>
    }

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-grid">
            <div>
                <div class="footer-name">@site.Name</div>
                <p class="muted">@site.Tagline</p>
                <p><a href="mailto:@site.ContactEmail">@site.ContactEmail</a></p>
            </div>
            <div>
                <h3 class="footer-title">Рассылка</h3>
                <p class="muted">Раз в месяц: новые проекты, события и тексты.</p>
                <form class="subscribe-form" id="subscribe" method="post" action="/subscribe" data-ajax>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                    <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
                    <div class="subscribe-row">
                        <input type="email" name="email" required placeholder="Ваша почта" aria-label="Почта" />
                        <button type="submit" class="btn">Подписаться</button>
                    </div>
                    <label class="check">
                        <input type="checkbox" name="consent" value="true" required />
                        <span>Согласен(на) с <a href="/privacy-policy">политикой конфиденциальности</a> и даю <a href="/agreement">согласие на обработку данных</a></span>
                    </label>
                    <p class="form-status" role="status"></p>
                </form>
            </div>
        </div>
        <div class="container footer-bottom">
            <span>© @DateTime.Now.Year @site.Name</span>
            <span class="footer-links">
                <a href="/privacy-policy">Политика конфиденциальности</a>
                <a href="/offer">Публичная оферта</a>
            </span>
        </div>
    </footer>

    <div class="cookie-banner" hidden>
        <p>Сайт использует cookie, чтобы работать корректно. <a href="/cookies">Подробнее</a></p>
        <button type="button" class="btn btn-small" data-cookie-ok>Хорошо</button>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
